import { ADD } from "./ApiControllers";

const adminBase =
  import.meta.env.BASE_URL && import.meta.env.BASE_URL !== "/"
    ? import.meta.env.BASE_URL
    : "/admin/";

const getStoredAuthToken = () => {
  if (typeof window === "undefined" || !window.localStorage) {
    return "";
  }

  try {
    const stored = window.localStorage.getItem("admin");
    if (!stored) {
      return "";
    }

    const parsed = JSON.parse(stored);
    return (
      parsed?.token ||
      parsed?.api_token ||
      parsed?.access_token ||
      parsed?.auth_token ||
      ""
    );
  } catch {
    return "";
  }
};

const clearClientSession = () => {
  if (typeof window === "undefined" || !window.localStorage) {
    return;
  }

  window.localStorage.removeItem("admin");
  window.localStorage.removeItem("isChecked");
  window.localStorage.removeItem("selectedClinic");
  window.localStorage.removeItem("selectedClinicId");
};

const Logout = async () => {
  const token = getStoredAuthToken();

  try {
    if (token) {
      await ADD(token, "logout", {});
    }
  } catch {
    // Always clear local auth state so users can exit even if the API request fails.
  } finally {
    clearClientSession();

    if (typeof window !== "undefined") {
      window.location.replace(adminBase);
    }
  }
};

export default Logout;
